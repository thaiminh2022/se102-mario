{

    "tasks": [
        {
            "label": "Copy Assets to Bin",
            "type": "shell",
            "command": "xcopy",
            "args": [
                "${workspaceFolder}\\Assets",
                "${workspaceFolder}\\x64\\Debug\\Assets",
                "/E", // Copies all subdirectories, even if empty
                "/I", // Assumes the destination is a folder, not a file
                "/Y", // Automatically overwrites existing files without asking
                "/D"  // SMART COPY: Only copies files that are newer than the ones in bin!
            ],
            "presentation": {
                "reveal": "silent" // Hides the output so it doesn't clutter your terminal
            }
        },
        {   
            "type": "cppbuild",
            "label": "C/C++: cl.exe build active file",
            "command": "cl.exe",
            "args": [
                "/Zi",
                "/EHsc",
                "/nologo",
                "/Fe${workspaceFolder}/x64/Debug/se102-mario.exe",
                "/DUNICODE",
                "/D_UNICODE",   

                "${workspaceFolder}/main.cpp",
                "/I", "${workspaceFolder}/packages/Microsoft.DXSDK.D3DX.9.29.952.8/build/native/include",
                "/link",
                
                "d3dx10.lib",

                "Gdi32.lib",
                "User32.lib",   
                
                "/LIBPATH:${workspaceFolder}/packages/Microsoft.DXSDK.D3DX.9.29.952.8/build/native/release/lib/x64",
                
                "d3d10.lib",
                "d3dcompiler.lib",
                "dxgi.lib"
            ],
            "dependsOn": "Copy Assets to Bin",
            "options": {
                "cwd": "${fileDirname}"
            },
            "problemMatcher": [
                "$msCompile"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "detail": "Task generated by Debugger."
        }
    ],
    "version": "2.0.0"
}