{
    "tasks": [
        {
            "type": "cppbuild",
            "label": "C/C++: cl.exe build active file",
            "command": "cl.exe",
            "args": [
                "/Zi",
                "/EHsc",
                "/nologo",
                "/Fe${workspaceFolder}/x64/Debug/se102-mario.exe",
                "/DUNICODE",
                "/D_UNICODE",   

                "${workspaceFolder}/main.cpp",
                "/I", "${workspaceFolder}/packages/Microsoft.DXSDK.D3DX.9.29.952.8/build/native/include",
                "/link",
                
                "d3dx10.lib",

                "Gdi32.lib",
                "User32.lib",   
                
                "/LIBPATH:${workspaceFolder}/packages/Microsoft.DXSDK.D3DX.9.29.952.8/build/native/release/lib/x64",
                
                "d3d10.lib",
                "d3dcompiler.lib",
                "dxgi.lib"
            ],
            "options": {
                "cwd": "${fileDirname}"
            },
            "problemMatcher": [
                "$msCompile"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "detail": "Task generated by Debugger."
        }
    ],
    "version": "2.0.0"
}